{
  "openapi": "3.1.0",
  "info": {
    "title": "AI 收纳辅助系统 · 开发 API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/scene": {
      "get": {
        "summary": "Read Scene",
        "operationId": "read_scene_api_scene_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scene"
                }
              }
            }
          }
        }
      }
    },
    "/api/scene/structure": {
      "post": {
        "summary": "Build Structure",
        "description": "Derive a multi-column cabinet skeleton; preview only, never written to the store.",
        "operationId": "build_structure_api_scene_structure_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StructureRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scene"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans": {
      "post": {
        "summary": "Create Plan",
        "operationId": "create_plan_api_plans_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VersionedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory/events": {
      "get": {
        "summary": "Events",
        "operationId": "events_api_inventory_events_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "post": {
        "summary": "Inventory Event",
        "operationId": "inventory_event_api_inventory_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scene"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/items/{item_id}/movable": {
      "patch": {
        "summary": "Set Movable",
        "operationId": "set_movable_api_items__item_id__movable_patch",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Item Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LockRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scene"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/apply": {
      "post": {
        "summary": "Apply Plan",
        "operationId": "apply_plan_api_plans__plan_id__apply_post",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plan Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scene"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/perception/capabilities": {
      "get": {
        "summary": "Perception Capabilities",
        "operationId": "perception_capabilities_api_perception_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplyRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          },
          "execution_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Execution Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "request_id",
          "execution_confirmed"
        ],
        "title": "ApplyRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InventoryRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "take",
              "return"
            ],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "request_id",
          "item_id",
          "action"
        ],
        "title": "InventoryRequest"
      },
      "Item": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "size": {
            "$ref": "#/components/schemas/Size"
          },
          "placement": {
            "$ref": "#/components/schemas/Placement"
          },
          "movable": {
            "type": "boolean",
            "title": "Movable",
            "default": true
          },
          "allow_rotation": {
            "type": "boolean",
            "title": "Allow Rotation",
            "default": true
          },
          "status": {
            "type": "string",
            "enum": [
              "stored",
              "taken_out"
            ],
            "title": "Status",
            "default": "stored"
          },
          "measurement_source": {
            "type": "string",
            "enum": [
              "synthetic",
              "manual",
              "sensor"
            ],
            "title": "Measurement Source",
            "default": "synthetic"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "size",
          "placement"
        ],
        "title": "Item"
      },
      "LockRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          },
          "movable": {
            "type": "boolean",
            "title": "Movable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "request_id",
          "movable"
        ],
        "title": "LockRequest"
      },
      "Placement": {
        "properties": {
          "shelf_id": {
            "type": "string",
            "title": "Shelf Id"
          },
          "column": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Column",
            "default": 0
          },
          "x": {
            "type": "integer",
            "minimum": 0.0,
            "title": "X"
          },
          "y": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Y"
          },
          "rotated": {
            "type": "boolean",
            "title": "Rotated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "shelf_id",
          "x",
          "y"
        ],
        "title": "Placement"
      },
      "Plan": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "input_version": {
            "type": "integer",
            "title": "Input Version"
          },
          "algorithm": {
            "type": "string",
            "const": "greedy-shelf-v1",
            "title": "Algorithm",
            "default": "greedy-shelf-v1"
          },
          "status": {
            "type": "string",
            "enum": [
              "FEASIBLE",
              "NO_SOLUTION_FOUND"
            ],
            "title": "Status"
          },
          "placements": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Placement"
            },
            "type": "object",
            "title": "Placements"
          },
          "unplaced_item_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unplaced Item Ids"
          },
          "moved_count": {
            "type": "integer",
            "title": "Moved Count"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "input_version",
          "status",
          "placements",
          "unplaced_item_ids",
          "moved_count",
          "notes"
        ],
        "title": "Plan"
      },
      "Scene": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "unit": {
            "type": "string",
            "const": "mm",
            "title": "Unit",
            "default": "mm"
          },
          "source": {
            "type": "string",
            "enum": [
              "synthetic",
              "user"
            ],
            "title": "Source",
            "default": "synthetic"
          },
          "shelves": {
            "items": {
              "$ref": "#/components/schemas/Shelf"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Shelves"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "shelves",
          "items"
        ],
        "title": "Scene"
      },
      "Shelf": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "size": {
            "$ref": "#/components/schemas/Size"
          },
          "elevation": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Elevation"
          },
          "columns": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Columns",
            "default": 1
          },
          "divider": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Divider",
            "default": 18
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "size",
          "elevation"
        ],
        "title": "Shelf"
      },
      "Size": {
        "properties": {
          "width": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "depth": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Depth"
          },
          "height": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Height"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "width",
          "depth",
          "height"
        ],
        "title": "Size"
      },
      "StructureRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "rows": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Rows"
          },
          "columns": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Columns"
          },
          "width": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "depth": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Depth"
          },
          "height": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Height"
          },
          "board": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Board",
            "default": 18
          },
          "divider": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Divider",
            "default": 18
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "rows",
          "columns",
          "width",
          "depth",
          "height"
        ],
        "title": "StructureRequest",
        "description": "External cabinet dimensions in mm; the backend derives the shelf Scene."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VersionedRequest": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "VersionedRequest"
      }
    }
  }
}
