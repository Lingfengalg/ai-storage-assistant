# Copy to .env on the server and fill in. Never commit the real .env.
TEAM_ADMIN_TOKEN=replace-with-openssl-rand-base64-24
TEAM_LEASE_MINUTES=90

# 有域名：填自有域名；只有公网 IP：填 <IP>.sslip.io
TEAM_DOMAIN=team.example.com

# 中国大陆构建时改用 PyPI 镜像，避免 files.pythonhosted.org 超时
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# Only for docker-compose.internal.yml (no-domain / Tailscale / LAN mode):
# run `tailscale ip -4` on the server and put the address here.
TEAM_BIND_IP=
